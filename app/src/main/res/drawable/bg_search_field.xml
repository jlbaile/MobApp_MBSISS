<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_search_field.xml
  ────────────────────
  Rounded rectangle background for the search EditText in
  fragment_violation.xml.

  Place this file in:  app/src/main/res/drawable/bg_search_field.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White fill -->
    <solid android:color="#FFFFFF"/>

    <!-- Light grey border -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD"/>

    <!-- Rounded corners -->
    <corners android:radius="6dp"/>

</shape>