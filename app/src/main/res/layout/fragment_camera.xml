<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_camera.xml
    ───────────────────
    Layer stack (bottom → top):
      1. PreviewView          — live camera feed (full screen)
      2. ScanOverlayView      — white corner brackets only (no dim)
      3. Instruction bar      — top of screen
      4. Thumbnail strip      — above bottom controls
      5. Bottom control bar   — Flash | Capture | Flip  +  Retake buttons
      6. Confirm & Save btn   — appears only after both sides confirmed
      7. ProgressBar          — centred, shown during capture/OCR
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- 2. Corner-bracket guide (no background — transparent) -->
    <com.example.mbsiss.Scanoverlayview
        android:id="@+id/scanOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. Instruction bar -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="#AA000000"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:text="Align FRONT of ID within frame"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 4. Thumbnail strip (front + back previews, above controls) -->
    <LinearLayout
        android:id="@+id/layoutThumbnails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#AA000000"
        android:padding="8dp">

        <!-- Front thumbnail -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgFrontPreview"
                android:layout_width="80dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:src="@android:color/darker_gray" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="FRONT"
                android:textColor="#AAFFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:paddingTop="2dp" />

            <Button
                android:id="@+id/btnRetakeFront"
                android:layout_width="80dp"
                android:layout_height="24dp"
                android:text="Retake"
                android:textSize="9sp"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                android:visibility="gone"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="#29B6F6" />
        </LinearLayout>

        <!-- Back thumbnail -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgBackPreview"
                android:layout_width="80dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:src="@android:color/darker_gray" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="BACK"
                android:textColor="#AAFFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:paddingTop="2dp" />

            <Button
                android:id="@+id/btnRetakeBack"
                android:layout_width="80dp"
                android:layout_height="24dp"
                android:text="Retake"
                android:textSize="9sp"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                android:visibility="gone"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:textColor="#29B6F6" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Bottom control bar: Flash | Capture | Flip -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="28dp"
        android:paddingTop="12dp"
        android:paddingHorizontal="32dp"
        android:background="#CC000000">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle flash"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Capture: outer ring wraps inner button -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center">

            <View
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/circle_white_border" />

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_white"
                android:text=""
                android:elevation="2dp" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Flip camera"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 6. Confirm & Save — hidden until both sides done -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:text="Confirm &amp; Save"
        android:backgroundTint="#29B6F6"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:enabled="false"
        android:visibility="gone"
        android:elevation="4dp" />

    <!-- 7. Progress spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#29B6F6"
        android:visibility="gone" />

</FrameLayout>