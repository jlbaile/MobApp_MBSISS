<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record Violation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#191C23"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search or scan a student ID to begin."
            android:textSize="13sp"
            android:textColor="#414754"
            android:layout_marginBottom="16dp"/>

        <!-- Search Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Student ID or Name..."
                android:inputType="text"
                android:padding="10dp"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/edit_text"/>

            <Button
                android:id="@+id/btnScanToFind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Scan"
                android:backgroundTint="#005BBF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Student Card (hidden until found) -->
        <LinearLayout
            android:id="@+id/cardStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#191C23"/>

            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: —"
                android:textSize="13sp"
                android:textColor="#414754"/>

            <TextView
                android:id="@+id/tvStudentCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Course | College"
                android:textSize="12sp"
                android:textColor="#727785"/>
        </LinearLayout>

        <!-- Violation Selector (hidden until student found) -->
        <LinearLayout
            android:id="@+id/layoutViolationSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Violation Category"
                android:textSize="12sp"
                android:textColor="#414754"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specific Violation"
                android:textSize="12sp"
                android:textColor="#414754"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerViolation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severity: —"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="12dp"
                android:background="#414754"/>

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes (optional)"
                android:minLines="2"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text"/>

            <Button
                android:id="@+id/btnSubmitViolation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Violation"
                android:backgroundTint="#BA1A1A"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Recent Logs Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Violation Logs"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#191C23"
            android:layout_marginBottom="8dp"/>

        <!-- Log RecyclerView (fixed height inside ScrollView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLog"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>