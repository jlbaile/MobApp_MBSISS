<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp"
    android:gravity="center_vertical">

    <!-- Icon Placeholder -->
    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="🪪"
        android:textSize="22sp"
        android:gravity="center"
        android:background="#EEF2FF"
        android:layout_marginEnd="12dp"/>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLogStudentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Student Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#191C23"/>

            <TextView
                android:id="@+id/tvLogSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minor"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#005BBF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogViolation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Violation Type"
            android:textSize="12sp"
            android:textColor="#414754"/>

        <TextView
            android:id="@+id/tvLogStudentId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: —"
            android:textSize="11sp"
            android:textColor="#727785"/>

        <TextView
            android:id="@+id/tvLogDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="11sp"
            android:textColor="#727785"/>
    </LinearLayout>
</LinearLayout>